DATABASE_URL=postgres://user:password@localhost:5432/vouchly
SITE_URL=http://localhost:3000

SMS_TEST_MODE=true
# SMS by Twilio. Sender: TWILIO_MESSAGING_SERVICE_SID, or TWILIO_FROM (a Twilio number or a registered name like Vouchly).
TWILIO_ACCOUNT_SID=
TWILIO_ACCOUNT_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Tests only: point at scripts/fake-twilio.mjs
TWILIO_BASE_URL=

PAYSTACK_SECRET_KEY=

# Email/password sign-in and password resets
RESEND_API_KEY=
RESEND_FROM=

# Google OAuth callback: {SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FOUNDER_INVITE_CODE=
CRON_SECRET=

# AI help (listing writer, posts, smart search). Leave AI_PROVIDER empty to turn AI off.
# cloudflare: CF_ACCOUNT_ID + CF_AI_TOKEN. anthropic: ANTHROPIC_API_KEY.
AI_PROVIDER=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_VISION=
AI_DAILY_LIMIT=300
# Tests only: point at scripts/fake-ai.mjs
AI_BASE_URL=
